# ============================================================================
# SHOPVN Backend Environment Configuration
# ============================================================================
# This is an example environment file. Copy this to .env.local and fill in
# your actual values. NEVER commit the real .env file to git!
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# ============================================================================
# DATABASE
# ============================================================================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Get from: MongoDB Atlas → Database → Connect → Connection String
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/shopvn?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT secret key for signing access tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters
JWT_SECRET=your_random_32_char_secret_key_here_generate_with_node

# Token encryption key (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_random_32_byte_encryption_key_here

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin JWT secret (separate from regular JWT_SECRET)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ADMIN_SECRET=your_admin_jwt_secret_here

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Frontend URL(s) for CORS - comma separated if multiple domains
# Production example: https://nosroblox.com,https://www.nosroblox.com
# Development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# (Legacy/backward compatibility)
CLIENT_ORIGIN=http://localhost:5173

# ============================================================================
# DISCORD BOT & OAUTH2 CONFIGURATION
# ============================================================================
# CRITICAL: These are required for Discord integration

# Bot token from Discord Developer Portal
# Get from: https://discord.com/developers/applications → Your App → Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# OAuth2 Client ID for Discord login
# Get from: https://discord.com/developers/applications → Your App → OAuth2 → Client ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# OAuth2 Client Secret
# Get from: https://discord.com/developers/applications → Your App → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Discord server (guild) ID
# Get by: Right-click Discord server → Copy Server ID
DISCORD_GUILD_ID=your_discord_guild_id_here

# Your Discord user ID (the bot owner)
# Get by: Right-click your username → Copy User ID
DISCORD_OWNER_ID=your_discord_user_id_here

# Discord redirect URI for OAuth2 callback
# Production: https://nosroblox.com/auth/discord/callback
# Development: http://localhost:5173/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# Discord server invite link (for display/sharing)
DISCORD_SERVER_INVITE=https://discord.gg/your_invite_code

# ============================================================================
# DISCORD CHANNELS (for notifications and features)
# ============================================================================
# Get channel IDs by: Right-click channel in Discord → Copy ID

# Support ticket category ID
DISCORD_TICKET_CATEGORY_ID=your_ticket_category_id_here

# Vouch/review channel ID
DISCORD_VOUCH_CHANNEL_ID=your_vouch_channel_id_here

# Wallet payment notification channel ID
DISCORD_WALLET_NOTIFY_CHANNEL_ID=your_wallet_notify_channel_id_here

# Owner role ID (optional, for role-based features)
DISCORD_OWNER_ROLE_ID=your_owner_role_id_here

# ============================================================================
# PAYMENT INTEGRATION: SEPAY (Bank Transfer)
# ============================================================================
# SePay webhook configuration for MB Bank transfers
# Get from: SePay Dashboard → API Settings

# Webhook secret for verifying SePay callbacks
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# MB Bank account number to receive transfers
SEPAY_MB_BANK_ACCOUNT=0123456789

# Account holder name (displayed to customers)
SEPAY_ACCOUNT_NAME=YOUR_COMPANY_NAME

# SePay API key (if needed for additional features)
SEPAY_API_KEY=your_sepay_api_key_here

# ============================================================================
# PAYMENT INTEGRATION: CARD PAYMENT (GachTheFast)
# ============================================================================
# Prepaid card payment service configuration

# Card payment API URL (usually fixed)
GACHTHEFAST_API_URL=https://api.gachthefast.com

# Partner ID from GachTheFast
GACHTHEFAST_PARTNER_ID=your_gachthefast_partner_id_here

# GachTheFast API key
GACHTHEFAST_API_KEY=your_gachthefast_api_key_here

# ============================================================================
# IMAGE UPLOAD: IMGBB
# ============================================================================
# ImgBB API key for uploading product images, banners, etc.
# Get from: https://imgbb.com → API → Your API Key
IMGBB_API_KEY=your_imgbb_api_key_here

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Redis URL (if using Redis caching)
# Example: redis://:password@localhost:6379
# REDIS_URL=redis://localhost:6379

# Enable Discord Gateway (for real-time features)
# DISCORD_ENABLE_GATEWAY=true

# Auto-join user to Discord server on login
# DISCORD_AUTO_JOIN_ON_LOGIN=true

# Product image upload directory
# PRODUCT_IMAGE_DIR=./uploads/product-images

# Banner image upload directory
# BANNER_IMAGE_DIR=./uploads/banners

# Trust proxy (if behind reverse proxy)
# TRUST_PROXY=1

# Force HTTP listen (instead of HTTPS)
# FORCE_HTTP_LISTEN=false

# ============================================================================
# MONITORING & LOGGING (Optional)
# ============================================================================

# Enable verbose logging
# DEBUG=*

# Log level (error, warn, info, debug, trace)
# LOG_LEVEL=info

# ============================================================================
# NOTES & SECURITY REMINDERS
# ============================================================================
#
# 1. NEVER commit the real .env file to git! Add .env to .gitignore
#
# 2. Generate random secrets using Node.js:
#    - JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - TOKEN_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. For production deployment on Render:
#    - Go to Render Dashboard → Select service → Environment
#    - Add these variables (Render won't show them for security)
#
# 4. For Discord Bot:
#    - Enable all Privileged Gateway Intents in Discord Developer Portal
#    - Add bot to your server with admin permissions
#    - Verify DISCORD_BOT_TOKEN starts with "MTk..." (indicates it's a token)
#
# 5. For Payment Integration:
#    - Test credentials on SePay/GachTheFast test environment first
#    - Switch to production credentials only after testing
#
# 6. Keep all secrets secure:
#    - Use strong passwords (min 32 chars for JWT_SECRET)
#    - Rotate secrets every 90 days in production
#    - Use different secrets for dev and production
#
# ============================================================================
