# App
NODE_ENV=production
CLIENT_ORIGIN=https://www.nosroblox.com,https://nosroblox.com
API_BASE_URL=https://your-render-api.onrender.com
VITE_API_BASE_URL=https://your-render-api.onrender.com
JWT_SECRET=replace-with-a-long-random-secret

# Bank display
BANK_NAME="MB Bank"
BANK_ACCOUNT_NAME="DOAN BAO SON"
BANK_ACCOUNT_NUMBER=09696969696969

# SePay bot / webhook
SEPAY_BOT_ENABLED=true
SEPAY_BOT_API_URL="https://my.sepay.vn/userapi/transactions/list?limit=20"
SEPAY_BOT_API_KEY=replace-with-sepay-api-key
SEPAY_BOT_INTERVAL_MS=5000
SEPAY_WEBHOOK_SECRET=replace-with-webhook-secret
SEPAY_WEBHOOK_HMAC_SECRET=replace-with-another-long-random-secret

# Turso persistent database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

# Optional initial admin bootstrap
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
